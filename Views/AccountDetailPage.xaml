<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PersonalFinanceApp.ViewModels"
             x:Class="PersonalFinanceApp.Views.AccountDetailPage"
             x:DataType="vm:AccountDetailViewModel"
             Title="Деталі рахунку">

    <VerticalStackLayout Padding="16" Spacing="8">
        <Label Text="Назва" />
        <Entry Text="{Binding Name}" />

        <Label Text="Тип рахунку" />
        <Entry Text="{Binding Type}" />

        <Label Text="Баланс" />
        <Entry Keyboard="Numeric" Text="{Binding Balance}" />

        <Button Text="Зберегти" Command="{Binding SaveCommand}" Margin="0,12,0,0" />
    </VerticalStackLayout>
</ContentPage>